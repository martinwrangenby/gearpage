{
  "name": "gear-page",
  "version": "0.1.0",
  "license": "MIT",
  "dependencies": {
    "firebase": "^12.12.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-firebase-hooks": "^5.1.1",
    "react-router-dom": "^7.18.2"
  },
  "scripts": {
    "lint": "eslint .",
    "lint:repair": "eslint . --fix",
    "start": "node scripts/devServerBootstrap.js && react-scripts start",
    "build": "react-scripts build",
    "e2e": "npx playwright test",
    "e2e:browserstack": "BROWSERSTACK=true browserstack-node-sdk playwright test --config=./playwright.config.browserstack.js",
    "e2e:ci": "CI=true npm run e2e",
    "test": "react-scripts test",
    "cleanup": "rimraf e2e/results log",
    "danger:ci": "danger ci",
    "danger:local": "danger pr"
  },
  "jest": {
    "transformIgnorePatterns": [
      "node_modules/(?!(@open-draft|@bundled-es-modules|headers-polyfill|is-node-process|outvariant|rettime|strict-event-emitter|until-async)/)",
      "^.+\\.module\\.(css|sass|scss)$"
    ],
    "moduleNameMapper": {
      "^react-router/dom$": "<rootDir>/node_modules/react-router/dist/development/dom-export.js"
    }
  },
  "husky": {
    "hooks": {
      "pre-commit": "npm run lint"
    }
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "1.57.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "browserstack-node-sdk": "^1.34.49",
    "danger": "^13.0.10",
    "dotenv": "^16.0.0",
    "eslint": "^8.11.0",
    "eslint-config-react-app": "^7.0.0",
    "eslint-plugin-playwright": "^0.8.0",
    "googleapis": "^99.0.0",
    "husky": "^4.3.7",
    "jest": "^29.7.0",
    "msw": "^2.15.0",
    "react-scripts": "^5.0.1",
    "rimraf": "^3.0.2"
  },
  "overrides": {
    "nth-check": "^2.1.1",
    "postcss": "^8.5.26",
    "serialize-javascript": "^7.1.0",
    "underscore": "^1.13.8",
    "cookie": "^0.7.0",
    "uuid": "^11.1.1",
    "@tootallnate/once": "2.0.1",
    "undici": "^6.28.0"
  }
}
